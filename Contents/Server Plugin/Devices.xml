	<!-- ============================================================ Doorbell / chime -->
	<Device type="sensor" id="rfxDoorbell">
		<Name>RF Doorbell / Chime</Name>
		<ConfigUI>
			<Field id="codeLabel" type="label" fontColor="darkgray">
				<Label>Devices are normally auto-created when the plugin hears them. To set one up by hand, press the remote/button (or wait for the sensor to transmit), then pick it below.</Label>
			</Field>
			<Field id="heardKey" type="menu" defaultValue="none">
				<Label>Recently heard:</Label>
				<List class="self" method="heardList" dynamicReload="true"/>
			</Field>
			<Field id="useHeard" type="button">
				<Label/>
				<Title>Use This Code</Title>
				<CallbackMethod>useHeardCode</CallbackMethod>
			</Field>
			<Field id="protocol" type="menu">
				<Label>Protocol:</Label>
				<List class="self" method="protocolList" filter="transmit" dynamicReload="true"/>
			</Field>
			<Field id="idString" type="textfield">
				<Label>RF id:</Label>
			</Field>
			<Field id="idHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
				<Label>Format as pyRFXtrx shows it, e.g. AC/HomeEasy UK "0abcdef:3", LightwaveRF "f1a2b3:1", ARC "B2", Oregon "9b:03".</Label>
			</Field>
			<Field id="deviceKey" type="textfield" hidden="true"/>
			<Field id="address" type="textfield" hidden="true"/>
			<Field id="autoCreated" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="pendingPatterns" type="textfield" hidden="true" defaultValue=""/>
			<Field id="migratedFrom" type="textfield" hidden="true" defaultValue=""/>
			<Field id="legacyStates" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="dbMigrated" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="sep1" type="separator"/>
			<Field id="momentarySeconds" type="textfield" defaultValue="5">
				<Label>Show as pressed for (seconds):</Label>
			</Field>
			<Field id="chimeSound" type="textfield" defaultValue="1">
				<Label>Default chime sound (0-15):</Label>
			</Field>
			<Field id="repeats" type="menu" defaultValue="1">
				<Label>Transmit:</Label>
				<List>
					<Option value="1">Once</Option>
					<Option value="2">Twice</Option>
				</List>
			</Field>
			<Field id="offlineAfterMinutes" type="textfield" defaultValue="0">
				<Label>Mark offline after (minutes):</Label>
			</Field>
			<Field id="offlineHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
				<Label>0 = never. Useful for sensors that report regularly.</Label>
			</Field>
			<Field id="SupportsSensorValue" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="SupportsOnState" type="checkbox" hidden="true" defaultValue="true"/>
		</ConfigUI>
		<States>
				<State id="command">
					<ValueType>String</ValueType>
					<TriggerLabel>Command (current - clears after the delay set on the device)</TriggerLabel>
					<ControlPageLabel>Command</ControlPageLabel>
				</State>
				<State id="lastCommand">
					<ValueType>String</ValueType>
					<TriggerLabel>Last Command (kept)</TriggerLabel>
					<ControlPageLabel>Last Command</ControlPageLabel>
				</State>
				<State id="lastSeen">
					<ValueType>String</ValueType>
					<TriggerLabel>Last Heard</TriggerLabel>
					<ControlPageLabel>Last Heard</ControlPageLabel>
				</State>
				<State id="lastSeenTimestamp">
					<ValueType>Integer</ValueType>
					<TriggerLabel>Last Heard (epoch)</TriggerLabel>
					<ControlPageLabel>Last Heard (epoch)</ControlPageLabel>
				</State>
				<State id="online">
					<ValueType boolType="TrueFalse">Boolean</ValueType>
					<TriggerLabel>Online</TriggerLabel>
					<ControlPageLabel>Online</ControlPageLabel>
				</State>
				<State id="signalStrength">
					<ValueType>Integer</ValueType>
					<TriggerLabel>Signal Strength (0-15)</TriggerLabel>
					<ControlPageLabel>Signal Strength</ControlPageLabel>
				</State>
		</States>
	</Device>

	<!-- ============================================================ Remote / handset -->
	<Device type="custom" id="rfxRemote">
		<Name>RF Remote / Wall Controller (receive only)</Name>
		<ConfigUI>
			<Field id="codeLabel" type="label" fontColor="darkgray">
				<Label>Devices are normally auto-created when the plugin hears them. To set one up by hand, press the remote/button (or wait for the sensor to transmit), then pick it below.</Label>
			</Field>
			<Field id="heardKey" type="menu" defaultValue="none">
				<Label>Recently heard:</Label>
				<List class="self" method="heardList" dynamicReload="true"/>
			</Field>
			<Field id="useHeard" type="button">
				<Label/>
				<Title>Use This Code</Title>
				<CallbackMethod>useHeardCode</CallbackMethod>
			</Field>
			<Field id="protocol" type="menu">
				<Label>Protocol:</Label>
				<List class="self" method="protocolList" filter="transmit" dynamicReload="true"/>
			</Field>
			<Field id="idString" type="textfield">
				<Label>RF id:</Label>
			</Field>
			<Field id="idHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
				<Label>Format as pyRFXtrx shows it, e.g. AC/HomeEasy UK "0abcdef:3", LightwaveRF "f1a2b3:1", ARC "B2", Oregon "9b:03".</Label>
			</Field>
			<Field id="deviceKey" type="textfield" hidden="true"/>
			<Field id="address" type="textfield" hidden="true"/>
			<Field id="autoCreated" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="pendingPatterns" type="textfield" hidden="true" defaultValue=""/>
			<Field id="migratedFrom" type="textfield" hidden="true" defaultValue=""/>
			<Field id="legacyStates" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="dbMigrated" type="checkbox" hidden="true" defaultValue="false"/>
			<Field id="sep1" type="separator"/>
			<Field id="remoteHelp" type="label" fontColor="darkgray">
				<Label>For handsets and wall controllers you only want to react to (mood buttons, scene buttons). Use the RF Command Received event, or the Command / Last Command states.</Label>
			</Field>
			<Field id="clearCommandSeconds" type="textfield" defaultValue="0">
				<Label>Clear Command after (seconds):</Label>
			</Field>
			<Field id="clearCommandHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
				<Label>Blanks the Command state (e.g. "Mood3") after this delay so the same command shows as a fresh change next time. Last Command always keeps the most recent one. 0 = never clear.</Label>
			</Field>
			<Field id="offlineAfterMinutes" type="textfield" defaultValue="0">
				<Label>Mark offline after (minutes):</Label>
			</Field>
			<Field id="offlineHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
				<Label>0 = never. Useful for sensors that report regularly.</Label>
			</Field>
		</ConfigUI>
		<States>
				<State id="command">
					<ValueType>String</ValueType>
					<TriggerLabel>Command (current - clears after the delay set on the device)</TriggerLabel>
					<ControlPageLabel>Command</ControlPageLabel>
				</State>
				<State id="lastCommand">
					<ValueType>String</ValueType>
					<TriggerLabel>Last Command (kept)</TriggerLabel>
					<ControlPageLabel>Last Command</ControlPageLabel>
				</State>
				<State id="lastSeen">
					<ValueType>String</ValueType>
					<TriggerLabel>Last Heard</TriggerLabel>
					<ControlPageLabel>Last Heard</ControlPageLabel>
				</State>
				<State id="lastSeenTimestamp">
					<ValueType>Integer</ValueType>
					<TriggerLabel>Last Heard (epoch)</TriggerLabel>
					<ControlPageLabel>Last Heard (epoch)</ControlPageLabel>
				</State>
				<State id="online">
					<ValueType boolType="TrueFalse">Boolean</ValueType>
					<TriggerLabel>Online</TriggerLabel>
					<ControlPageLabel>Online</ControlPageLabel>
				</State>
				<State id="signalStrength">
					<ValueType>Integer</ValueType>
					<TriggerLabel>Signal Strength (0-15)</TriggerLabel>
					<ControlPageLabel>Signal Strength</ControlPageLabel>
				</State>
		</States>
		<UiDisplayStateId>lastCommand</UiDisplayStateId>
	</Device>

	<!-- ============================================================ Interface -->
